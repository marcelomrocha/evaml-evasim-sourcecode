            </case>
            <default key="1066" child_proc="false" value="" op="exact" /></switch>
          </case>
          <case op="contain" value="3" key="1067" child_proc="true" var="respostaa">
            <evaEmotion emotion="SAD" key="1068" />
            <motion type="2NO" key="1069" />
            <talk key="1070">Você errou! Deseja tentar novamente ou ir para a próxima pergunta?</talk>
            <mqtt topic="eva/video/play" key="1071">amina-repetir.png</mqtt>
