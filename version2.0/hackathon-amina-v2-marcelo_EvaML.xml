              <talk key="1149">Você acertou, Parabéns!</talk> 
              <motion type="2YES" key="1150" />
              <motion leftArm="SHAKE2" rightArm="SHAKE2" key="1151" />
              <motion type="2YES" key="1152" />
              <motion leftArm="SHAKE2" rightArm="SHAKE2" key="1153" />
              <audio source="song-beyonce" block="FALSE" key="1154" />
              <light state="ON" color="GREEN" key="1155" />
              <wait duration="1000" key="1156" />
              <light state="ON" color="PINK" key="1157" />
              <wait duration="1000" key="1158" /> 
              <light state="ON" color="GREEN" key="1159" />
              <wait duration="1000" key="1160" />
              <light state="ON" color="PINK" key="1161" />
              <wait duration="1000" key="1162" /> 
              <light state="ON" color="GREEN" key="1163" />
              <wait duration="1000" key="1164" />
              <light state="ON" color="PINK" key="1165" />
