    <case op="exact" value="1" key="1008" child_proc="true" var="ligar">
      <mqtt topic="eva/video/play" key="1009">amina-capa.png</mqtt>
      <evaEmotion emotion="HAPPY" key="1010" />
      <talk key="1011">Olá, como você está? O que você gostaria de aprender hoje?</talk>
      <mqtt topic="eva/video/play" key="1012">amina-eletroquimica.png</mqtt>
      <qrRead var="problema" key="1013" />
      <switch var="problema">
        <case op="exact" value="1" key="1014" child_proc="true" var="problema">
          <wait duration="2000" id="VOLTAR" key="1015" />
          <talk key="1016">Como você deseja aprender? Com perguntas ou dicas?</talk> 
          <mqtt topic="eva/video/play" key="1017">amina-perguntas.png</mqtt>
          <qrRead var="resposta" key="1018" />
          <switch var="resposta">
            <case op="contain" value="2" key="1019" child_proc="true" var="resposta">
              <mqtt topic="eva/video/play" key="1020">amina-capa.png</mqtt>
              <talk key="1021">Tudo bem, aqui vão algumas dicas para te ajudar em eletroquímica.  </talk>
              <wait duration="2000" key="1022" />
              <talk key="1023">Primeiro, vá para um local confortável, seja na praia, na biblioteca ou em uma praça e leve seu livro.</talk> 
              <talk key="1024">Com a ajuda do livro faça um resumo do que você entendeu.</talk>
              <goto target="AMINA_ENCERRAR" />
            </case>
            <case op="contain" value="1" key="1025" child_proc="true" var="resposta">
              <evaEmotion emotion="NEUTRAL" key="1026" />
              <talk key="1027">Tudo bem, vamos começar!</talk> 
              <wait duration="1000" id="TENTEDNV" key="1028" />
              <evaEmotion emotion="NEUTRAL" key="1029" />
              <mqtt topic="eva/video/play" key="1030">amina-capa.png</mqtt>
              <talk key="1031">Qual é o fenômeno que ocorre ao juntar água e sal de cozinha separando os íons?</talk>
              <mqtt topic="eva/video/play" key="1032">amina-opcoes.png</mqtt>
              <talk key="1033">1, corrosão</talk>
              <talk key="1034">2, redução dos íons</talk>
              <talk key="1035">3, reações nucleares</talk> 
              <talk key="1036">4, dissociação iônica</talk>
              <qrRead var="respostaa" key="1037" /> 
              <switch var="respostaa">
                <case op="contain" value="1" key="1038" child_proc="true" var="respostaa">
                  <mqtt topic="eva/video/play" key="1039">amina-capa.png</mqtt>
                  <evaEmotion emotion="SAD" key="1040" />
                  <motion type="2NO" key="1041" />
                  <talk key="1042">Você errou! Deseja tentar novamente ou ir para a próxima pergunta?</talk>
                  <mqtt topic="eva/video/play" key="1043">amina-repetir.png</mqtt>
                  <qrRead var="repouenc" key="1044" />
                  <switch var="repouenc">
                    <case op="contain" value="1" key="1045" child_proc="true" var="repouenc">
                      <mqtt topic="eva/video/play" key="1046">amina-capa.png</mqtt>
                      <talk key="1047">vamos la</talk>
                      <goto target="TENTEDNV" />
                    </case>
                  <default key="1048" child_proc="false" value="" op="exact" /></switch>
          <switch var="repouenc">
            <case op="contain" value="2" key="1049" child_proc="true" var="repouenc">
              <mqtt topic="eva/video/play" key="1050">amina-capa.png</mqtt>
              <talk key="1051">vamos para a próxima pergunta</talk>
            </case>
          <default key="1052" child_proc="false" value="" op="exact" /></switch>
          </case>
          <case op="contain" value="2" key="1053" child_proc="true" var="respostaa">
            <evaEmotion emotion="SAD" key="1054" />
            <motion type="2NO" key="1055" />
            <talk key="1056">Você errou! Deseja tentar novamente ou ir para a próxima pergunta?</talk>
            <mqtt topic="eva/video/play" key="1057">amina-repetir.png</mqtt>
            <qrRead var="repouenc" key="1058" />
            <switch var="repouenc">
            <case op="contain" value="1" key="1059" child_proc="true" var="repouenc">
              <mqtt topic="eva/video/play" key="1060">amina-capa.png</mqtt>
