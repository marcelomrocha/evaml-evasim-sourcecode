<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="divas-altivas-v2" xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd" id="74bc65323fb9f4a68f19c80e30650ad4">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" key="1000" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <mqtt topic="eva/video/play" key="1001">divas-capa.png</mqtt>
    <talk key="1002">Oi, eu sou o robô Eva!</talk>
    <evaEmotion emotion="HAPPY" key="1003" />
    <led animation="RAINBOW" key="1004" />
    <wait duration="2000" key="1005" />
    <talk key="1006">Me fale o seu nome.</talk>
    <qrRead var="nome" key="1007" />
    <evaEmotion emotion="INLOVE" key="1008" />
    
    
    <talk key="1009">Prazer, heloísa</talk>
    <talk key="1010">fiquei sabendo que você tem um grande problema em relação a timidez.</talk>
    <talk key="1011">Preparei um jogo para você!</talk>
    <talk id="volta" key="1012">escolha um cartão</talk>
    <mqtt topic="eva/video/play" key="1013">divas-opcoes.png</mqtt>
    <evaEmotion emotion="NEUTRAL" key="1014" />
    <qrRead var="cartao" key="1015" />
    <switch var="cartao">
      
      <case op="exact" value="1" key="1016" child_proc="true" var="cartao">
        <mqtt topic="eva/video/play" key="1017">divas-capa.png</mqtt>
        <talk key="1018">vamos dançar comigo!</talk>
        <evaEmotion emotion="HAPPY" key="1019" />
        <audio source="song-macarena-edit" block="FALSE" key="1020" />
        <led animation="RAINBOW" key="1021" />
        <motion head="2YES" key="1022" />
        <motion leftArm="SHAKE1" key="1023" />
        <motion rightArm="SHAKE2" key="1024" />
        <wait duration="5000" key="1025" />
        <motion head="2YES" key="1026" />
        <motion leftArm="SHAKE1" key="1027" />
        <motion rightArm="SHAKE2" key="1028" />
        <wait duration="5000" key="1029" />
        <led animation="RAINBOW" key="1030" />
        <motion head="2YES" key="1031" />
        <motion leftArm="SHAKE1" key="1032" />
        <motion rightArm="SHAKE2" key="1033" />
        <wait duration="5000" key="1034" />
        <motion head="2YES" key="1035" />
        <motion leftArm="SHAKE1" key="1036" />
        <motion rightArm="SHAKE2" key="1037" />
        <wait duration="5000" key="1038" />
        <motion head="2YES" key="1039" />
        <motion leftArm="SHAKE1" key="1040" />
        <motion rightArm="SHAKE2" key="1041" />
        <wait duration="8000" key="1042" />
        <led animation="RAINBOW" key="1043" />
      </case>
      
      <case op="exact" value="2" key="1044" child_proc="true" var="cartao">
        <mqtt topic="eva/video/play" key="1045">divas-capa.png</mqtt>
        <talk key="1046">Vamos cantar juntos?</talk>
        <light state="ON" color="PINK" key="1047" />
        <audio source="song-happy" block="FALSE" key="1048" />
        <evaEmotion emotion="SURPRISE" key="1049" />
        <wait duration="6000" key="1050" />
        <light state="OFF" key="1051" />
        <evaEmotion emotion="HAPPY" key="1052" />
      </case>
      
      <case op="exact" value="3" key="1053" child_proc="true" var="cartao">
        <mqtt topic="eva/video/play" key="1054">divas-capa.png</mqtt>
        <talk key="1055">vou contar uma piada</talk>
        <talk key="1056"> Por que a velhinha não usa relógio? </talk>
        <audio source="efx-tic-toc" block="TRUE" key="1057" />
        <talk key="1058">Porque ela é sem hora.</talk>
        <evaEmotion emotion="HAPPY" key="1059" />
        <motion head="2YES" key="1060" />
        <audio source="efx-trombone-triste" block="TRUE" key="1061" />
      </case>
    <default key="1062" child_proc="false" value="" op="exact" /></switch>
    
    <talk key="1063">você deseja escolher mais um cartão?</talk>
    <mqtt topic="eva/video/play" key="1064">divas-opcoes2.png</mqtt>
    <qrRead var="Resposta" key="1065" />
    <switch var="Resposta">
      <case op="contain" value="sim" key="1066" child_proc="true" var="Resposta">
        <goto target="volta" />
      </case>
      <default key="1067" child_proc="true" value="" op="exact">
        <talk key="1068">tudo bem!</talk>
        <wait duration="3000" key="1069" />
        
      </default>
    </switch>
    
    <talk key="1070">Espero que eu tenha te ajudado, heloísa!</talk>
    <talk key="1071">até a próxima!</talk>
    <audio source="efx-aplausos-bom" block="FALSE" key="1072" />
    <led animation="RAINBOW" key="1073" />
    <wait duration="5000" key="1074" />
  </script>
