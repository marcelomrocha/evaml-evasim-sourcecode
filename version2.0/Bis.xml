<?xml version="1.0" encoding="UTF-8"?>
<evaml
  name="BIS" 
  xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <!-- Interação do usuário com a EVA-->
    <listen />
    <evaEmotion emotion="HAPPY" />
    <talk>Olá, que bom que você veio.</talk>
    <wait duration="2000" />
    <motion left-arm="POSITION 0" right-arm="POSITION 3"/>
    <motion right-arm="DOWN"/>
    <wait duration="2000" />  
    <evaEmotion emotion="NEUTRAL" />
    <talk>Como você está se sentindo? Escolha um dos QR Côudes.</talk>
    <!-- De acordo com a resposta da Brita, 
    a Eva vai reagir com um rostinho de acordo com os
    sentimentos da Brita-->
    <qrRead var="sentimento"/>
    <switch var="sentimento">
      <case op="exact" value="alegria">
        <audio source="song-samba-loop" block="TRUE" />
        <talk>Que bom que você está feliz.</talk>
      </case>
      <default>
        <evaEmotion emotion="SAD" />
        <light state="ON" color="BLUE"/>
        <talk>Eu posso te ajudar com isso. Aqui estão algumas
              recomendações de filmes e músicas</talk>
        <random min="1" max="1" />
        <switch var="$">
          <case op="eq" value="1">
            <talk>Então escute just the whay you are</talk>
            <audio source="efx-crowdapplause1" block="TRUE" />
          </case>
        </switch>
      </default>
    </switch>
  </script>
</evaml>


