<?xml version="1.0" encoding="UTF-8"?>
<evaml
  name="galaxya" 
  xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice"/>
    <lightEffects mode="ON"/>
    <audioEffects mode="ON"/>
  </settings>
  <script>
    <evaEmotion emotion="HAPPY"/> 
    <talk>Olá! Meu nome é Eva.</talk>   
    <talk>Qual é o seu nome?</talk>
    <listen var="nome"/>
    <talk>#nome , você gostaria de ajuda para estudar Inglês?
          para aprender o verbo to be</talk>
    <listen /> 
    <switch var='$'>
      <case op='exact' value='sim'>
        <evaEmotion emotion="INLOVE" />
        <talk>”legal vamos la”</talk> 
        <audio source="efx-mario-game-intro" block="TRUE"/> 
        <talk> preste atenção na musica </talk> 
        <audio source="Bruno Mars.wav" block="TRUE"/> 
        <talk> indique com o cartao qual verbo to be está na musica </talk> 
        <qrRead id="voltar"/>  
        <switch var='$'>
          <case op='exact' value='are'>
            <evaEmotion emotion="HAPPY" />
            <talk>”parabéns!!! você acertou!”</talk> 
            <audio source='efx-aplausos-bom' block="TRUE"/> 
          </case>
          <default> 
            <talk> 
              você errou tente novamente
            </talk>
            <goto target="voltar" />
          </default>
        </switch>
    </case>
    <case op="exact" value="não">
        <evaEmotion emotion='SAD' />
        <talk>”ai que pena, até a próxima.”</talk> 
        <audio source="song-sad-violin" block="TRUE"/>
    </case>
    </switch>
  </script>
</evaml> 
     
     