<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Âmina" xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd" id="96c9a87ef9c1e1a0f745a3c5032732cd">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" key="1000" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <listen var="ligar" key="1001" />
    <evaEmotion emotion="HAPPY" key="1002" />
    <talk key="1003">Bom dia, Maitê! O que você gostaria de aprender hoje?</talk>
    <listen var="problema" key="1004" />
    <wait duration="500" id="VOLTAR" key="1005" />
    <talk key="1006">Tudo bem! Como você deseja aprender? Com qüiz ou dicas?</talk> 
    <listen var="resposta" key="1007" />
    <switch var="resposta">
      <case op="contain" value="dicas" key="1008" child_proc="true" var="resposta">
        <talk key="1009">Tudo bem, aqui vão algumas dicas para te ajudar em eletroquímica.  </talk>
        <wait duration="2000" key="1010" />
        <talk key="1011">Primeiro, vá para um local confortável, seja na praia, na biblioteca ou em uma praça e leve seu livro.</talk> 
        <talk key="1012">Com a ajuda do livro faça um resumo do que você entendeu.</talk>
        <goto target="VOLTAR" />
      </case>
      <case op="contain" value="quiz" key="1013" child_proc="true" var="resposta">
        <talk key="1014">Tudo bem, vamos começar!</talk> 
        <wait duration="1000" id="TENTEDNV" key="1015" />
        <talk key="1016">Qual é o fenômeno que ocorre ao juntar água e sal de cozinha separando os íons?</talk>
        <talk key="1017">1, corrosão</talk>
        <talk key="1018">2, redução dos íons</talk>
        <talk key="1019">3, reações nucleares</talk> 
        <talk key="1020">4, dissociação iônica</talk> 
        <listen var="respostaa" key="1021" /> 
        
        <switch var="respostaa">
          <case op="contain" value="1" key="1022" child_proc="true" var="respostaa">
            <evaEmotion emotion="SAD" key="1023" />
            <talk key="1024">Você errou, tente novamente!</talk>
            <motion type="2NO" key="1025" />
            <goto target="TENTEDNV" />
          </case>
          <case op="contain" value="2" key="1026" child_proc="true" var="respostaa">
            <evaEmotion emotion="SAD" key="1027" />
            <talk key="1028">Você errou, tente novamente!</talk>
            <motion type="2NO" key="1029" />
            <goto target="TENTEDNV" />
          </case>
          <case op="contain" value="3" key="1030" child_proc="true" var="respostaa">
            <evaEmotion emotion="SAD" key="1031" />
            <talk key="1032">Você errou, tente novamente!</talk>
            <motion type="2NO" key="1033" />
            <goto target="TENTEDNV" />
          </case>
          <case op="contain" value="4" key="1034" child_proc="true" var="respostaa">
            <evaEmotion emotion="HAPPY" key="1035" />
            <talk key="1036">Você acertou, Parabéns!</talk> 
            <light state="ON" color="GREEN" key="1037" />
            <wait duration="1000" key="1038" />
            <light state="ON" color="PINK" key="1039" />
            <wait duration="1000" key="1040" /> 
          </case>
          <default key="1041" child_proc="true" value="" op="exact">
            <talk key="1042">resposta inválida</talk>
            <goto target="TENTEDNV" />
          </default>
        </switch> 
        <evaEmotion emotion="NEUTRAL" id="REPETE" key="1043" />
        <talk key="1044"> Continuando, a eletroquímica é dividida em quais principais assuntos?</talk>
        <talk key="1045"> 1, pilhas e baterias </talk>
        <talk key="1046"> 2, eletrólise e baterias</talk>
        <talk key="1047"> 3, baterias e correntes</talk>
        <talk key="1048"> 4, pilhas e eletrólise</talk> 
        
        <listen var="respostaaa" key="1049" /> 
        <switch var="respostaaa">
          <case op="contain" value="1" key="1050" child_proc="true" var="respostaaa">
            <evaEmotion emotion="SAD" key="1051" />
            <talk key="1052">Você errou, tente novamente!</talk>
            <motion type="2NO" key="1053" />
            <goto target="REPETE" />
          </case>
          <case op="contain" value="2" key="1054" child_proc="true" var="respostaaa">
            <evaEmotion emotion="SAD" key="1055" />
            <talk key="1056">Você errou, tente novamente!</talk>
            <motion type="2NO" key="1057" />
            <goto target="REPETE" />
          </case>
          <case op="contain" value="3" key="1058" child_proc="true" var="respostaaa">
            <evaEmotion emotion="SAD" key="1059" />
            <talk key="1060">Você errou, tente novamente!</talk>
            <motion type="2NO" key="1061" />
            <goto target="REPETE" />
          </case>
          <case op="contain" value="4" key="1062" child_proc="true" var="respostaaa">
            <evaEmotion emotion="HAPPY" key="1063" />
            <talk key="1064">Você acertou, Parabéns!</talk> 
            <light state="ON" color="GREEN" key="1065" />
            <wait duration="1000" key="1066" />
            <light state="ON" color="PINK" key="1067" />
            <wait duration="1000" key="1068" /> 
          </case>
          <default key="1069" child_proc="true" value="" op="exact">
            <talk key="1070">resposta inválida</talk>
            <goto target="REPETE" />
          </default>
        </switch> 
      </case> 
      <default key="1071" child_proc="true" value="" op="exact">
        <talk key="1072">resposta inválida</talk>
        <goto target="VOLTAR" />
      </default>
    </switch>
    <talk key="1073">Foi um prazer estudar com você, boa prova!</talk>
    <stop />
  </script>
