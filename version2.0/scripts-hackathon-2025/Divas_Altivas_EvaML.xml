    <talk key="1008">Prazer #nome</talk>
    <talk key="1009">fiquei sabendo que você tem um grande problema em relação a timidez.</talk>
    <talk key="1010">Preparei um jogo para você, escolha um cartão!</talk>
    <evaEmotion emotion="NEUTRAL" key="1011" />
    <qrRead var="cartao" key="1012" />
    <switch var="cartao">
      <case op="exact" value="dançar" key="1013" child_proc="true" var="cartao">
        <talk key="1014">vamos dançar comigo!</talk>
        <evaEmotion emotion="HAPPY" key="1015" />
        <audio source="song-macarena-edit" block="FALSE" key="1016" />
        <led animation="RAINBOW" key="1017" />
        <motion head="2YES" key="1018" />
        <motion leftArm="SHAKE1" key="1019" />
        <motion rightArm="SHAKE2" key="1020" />
        <wait duration="5000" key="1021" />
        <motion head="2YES" key="1022" />
        <motion leftArm="SHAKE1" key="1023" />
        <motion rightArm="SHAKE2" key="1024" />
        <wait duration="5000" key="1025" />
