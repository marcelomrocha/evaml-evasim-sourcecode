<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Divas_Altivas" xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd" id="baf0919dc8369a69972b527d70f9ffad">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" key="1000" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <talk key="1001">Oi, eu sou a Eva!</talk>
    <evaEmotion emotion="HAPPY" key="1002" />
    <led animation="RAINBOW" key="1003" />
    <wait duration="4000" key="1004" />
    <talk key="1005">Me fale o seu nome.</talk>
    <listen var="nome" key="1006" />
