        <motion head="2YES" key="1035" />
        <motion leftArm="SHAKE1" key="1036" />
        <motion rightArm="SHAKE2" key="1037" />
        <wait duration="8000" key="1038" />
        <led animation="RAINBOW" key="1039" />
      </case>
      <case op="exact" value="dancar" key="1040" child_proc="true" var="cartao">
        <talk key="1041">vamos dançar comigo!</talk>
        <evaEmotion emotion="HAPPY" key="1042" />
        <audio source="song-macarena-edit" block="FALSE" key="1043" />
        <led animation="RAINBOW" key="1044" />
        <motion head="2YES" key="1045" />
        <motion leftArm="SHAKE1" key="1046" />
        <motion rightArm="SHAKE2" key="1047" />
        <wait duration="5000" key="1048" />
        <motion head="2YES" key="1049" />
        <motion leftArm="SHAKE1" key="1050" />
        <motion rightArm="SHAKE2" key="1051" />
        <wait duration="5000" key="1052" />
        <led animation="RAINBOW" key="1053" />
        <motion head="2YES" key="1054" />
        <motion leftArm="SHAKE1" key="1055" />
        <motion rightArm="SHAKE2" key="1056" />
        <wait duration="5000" key="1057" />
        <motion head="2YES" key="1058" />
        <motion leftArm="SHAKE1" key="1059" />
        <motion rightArm="SHAKE2" key="1060" />
        <wait duration="5000" key="1061" />
        <motion head="2YES" key="1062" />
        <motion leftArm="SHAKE1" key="1063" />
        <motion rightArm="SHAKE2" key="1064" />
        <wait duration="8000" key="1065" />
        <led animation="RAINBOW" key="1066" />
      </case>
      <case op="exact" value="cantar" key="1067" child_proc="true" var="cartao">
        <talk key="1068">Vamos cantar juntos?</talk>
        <light state="ON" color="PINK" key="1069" />
        <audio source="song-happy" block="FALSE" key="1070" />
        <evaEmotion emotion="SURPRISE" key="1071" />
        <wait duration="6000" key="1072" />
        <light state="OFF" key="1073" />
        <evaEmotion emotion="HAPPY" key="1074" />
      </case>
      <case op="exact" value="piada" key="1075" child_proc="true" var="cartao">
        <talk key="1076">vou contar uma piada</talk>
        <talk key="1077"> Por que a velhinha não usa relógio? </talk>
        <audio source="efx-tic-toc" block="TRUE" key="1078" />
        <talk key="1079">Porque ela é sem hora.</talk>
        <evaEmotion emotion="HAPPY" key="1080" />
        <motion head="2YES" key="1081" />
        <audio source="efx-trombone-triste" block="TRUE" key="1082" />
      </case>
    <default key="1083" child_proc="false" value="" op="exact" /></switch>
    <talk key="1084">Espero que eu tenha te ajudado, #nome!</talk>
    <talk key="1085">até a próxima!</talk>
    <audio source="efx-aplausos-bom" block="FALSE" key="1086" />
    <led animation="RAINBOW" key="1087" />
  </script>
