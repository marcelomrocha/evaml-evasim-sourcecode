  <case op="contain" value="4" key="1108" child_proc="true" var="respostaaa">
    <evaEmotion emotion="HAPPY" key="1109" />
    <talk key="1110">Você acertou, Parabéns!</talk> 
    <audio source="song-beyonce" block="FALSE" key="1111" />
  <motion type="2YES" key="1112" />
  <motion leftArm="SHAKE2" rightArm="SHAKE2" key="1113" />
  <motion type="2YES" key="1114" />
  <motion leftArm="SHAKE2" rightArm="SHAKE2" key="1115" />
    <light state="ON" color="GREEN" key="1116" />
    <wait duration="1000" key="1117" />
    <light state="ON" color="PINK" key="1118" />
    <wait duration="1000" key="1119" /> 
  </case>
  <default key="1120" child_proc="true" value="" op="exact">
    <talk key="1121">resposta inválida</talk>
    <goto target="REPETE" />
  </default>
    </switch> 
</case> 
<default key="1122" child_proc="true" value="" op="exact">
  <talk key="1123">resposta inválida</talk>
  <goto target="VOLTAR" />
</default>
</switch>
<talk key="1124">Foi um prazer estudar com você, boa prova!</talk>
