<?xml version="1.0" encoding="utf-8"?>
<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="script" xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" />
  </settings>
  <script>
    <light state="ON" />
    <wait id="inicio" duration="2" />
    <useMacro macro="alo" />
