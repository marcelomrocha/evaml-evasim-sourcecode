<?xml version="1.0" encoding="UTF-8"?>
<evaml
  name="divas-altivas-v2"
  xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <mqtt topic="eva/video/play">divas-capa.png</mqtt>
    <talk>Oi, eu sou o robô Eva!</talk>
    <evaEmotion emotion="HAPPY" />
    <led animation="RAINBOW" />
    <wait duration="2000" />
    <talk>Me fale o seu nome.</talk>
    <qrRead var="nome"/>
    <evaEmotion emotion="INLOVE" />
    <!-- A variável foi removida para que não fosse necessário o uso de outro qrcode -->
    <!-- Por causa do problema do acento no nome de Heloísa, a variável foi substituída pela constante -->
    <talk>Prazer, heloísa</talk>
    <talk>fiquei sabendo que você tem um grande problema em relação a timidez.</talk>
    <talk>Preparei um jogo para você!</talk>
    <talk id="volta">escolha um cartão</talk>
    <mqtt topic="eva/video/play">divas-opcoes.png</mqtt>
    <evaEmotion emotion="NEUTRAL" />
    <qrRead var="cartao"/>
    <switch var="cartao">
      <!-- 1 - Dançar -->
      <case op="exact" value="1">
        <mqtt topic="eva/video/play">divas-capa.png</mqtt>
        <talk>vamos dançar comigo!</talk>
        <evaEmotion emotion="HAPPY" />
        <audio source="song-macarena-edit" block="FALSE" />
        <led animation="RAINBOW" />
        <motion head="2YES"/>
        <motion leftArm="SHAKE1"/>
        <motion rightArm="SHAKE2"/>
        <wait duration="5000" />
        <motion head="2YES"/>
        <motion leftArm="SHAKE1"/>
        <motion rightArm="SHAKE2"/>
        <wait duration="5000" />
        <led animation="RAINBOW" />
        <motion head="2YES"/>
        <motion leftArm="SHAKE1"/>
        <motion rightArm="SHAKE2"/>
        <wait duration="5000" />
        <motion head="2YES"/>
        <motion leftArm="SHAKE1"/>
        <motion rightArm="SHAKE2"/>
        <wait duration="5000" />
        <motion head="2YES"/>
        <motion leftArm="SHAKE1"/>
        <motion rightArm="SHAKE2"/>
        <wait duration="8000" />
        <led animation="RAINBOW" />
      </case>
      <!-- 2 - Cantar -->
      <case op="exact" value="2">
        <mqtt topic="eva/video/play">divas-capa.png</mqtt>
        <talk>Vamos cantar juntos?</talk>
        <light state="ON" color="PINK"/>
        <audio source="song-happy" block="FALSE" />
        <evaEmotion emotion="SURPRISE" />
        <wait duration="6000" />
        <light state="OFF" />
        <evaEmotion emotion="HAPPY" />
      </case>
      <!-- 3 - Piada -->
      <case op="exact" value="3">
        <mqtt topic="eva/video/play">divas-capa.png</mqtt>
        <talk>vou contar uma piada</talk>
        <talk> Por que a velhinha não usa relógio? </talk>
        <audio source="efx-tic-toc" block="TRUE" />
        <talk>Porque ela é sem hora.</talk>
        <evaEmotion emotion="HAPPY" />
        <motion head="2YES"/>
        <audio source="efx-trombone-triste" block="TRUE" />
      </case>
    </switch>
    <!-- Esta parte foi adicionada na segunda versão. -->
    <talk>você deseja escolher mais um cartão?</talk>
    <mqtt topic="eva/video/play">divas-opcoes2.png</mqtt>
    <qrRead var="Resposta"/>
    <switch var="Resposta">
      <case op="contain" value="sim">
        <goto target="volta" />
      </case>
      <default>
        <talk>tudo bem!</talk>
        <wait duration="3000" />
        <!-- Volta o menu inicial -->
      </default>
    </switch>
    <!-- A parte adicionada na segunda versão termina aqui. -->
    <talk>Espero que eu tenha te ajudado, heloísa!</talk>
    <talk>até a próxima!</talk>
    <audio source="efx-aplausos-bom" block="FALSE" />
    <led animation="RAINBOW" />
    <wait duration="8000" />
  </script>
</evaml>