<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="hackathon360_demo_2025" xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd" id="02b4debadb486a265d64d1a7f70545b2">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" key="1000" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    
    <light state="OFF" key="1001" />
    <evaEmotion emotion="NEUTRAL" key="1002" />
    <led animation="STOP" key="1003" />
    <motion head="CENTER" rightArm="POSITION 0" leftArm="POSITION 0" key="1004" />
    <talk key="1005">Olá pessoal!</talk>
    <talk key="1006">Eu me chamo EVA.</talk>
    <audio source="efx-blin2" block="TRUE" key="1007" />
    <talk key="1008">Sou um robô social</talk>
    <wait duration="1500" key="1009" />
    <talk key="1010">Posso ser usado em aplicações em saúde e educação</talk>
    <audio source="efx-blin2" block="TRUE" key="1011" />
    <talk key="1012">Agora, vou demonstrar algumas das minhas capacidades</talk>

    <talk key="1013">Apesar de estar falando em português, eu posso falar em outros idiomas</talk>
    <wait duration="1500" key="1014" />
    <talk key="1015">Posso falar em inglês</talk>
    <wait duration="1500" key="1016" />
    <talk tone="en-US_EmmaExpressive" key="1017">Hello there, how are you doing?</talk>
    <wait duration="1500" key="1018" />
    <talk key="1019">Também posso falar em espanhol</talk>
    <wait duration="1500" key="1020" />
    <talk tone="es-ES_LauraV3Voice" key="1021">¿Hola, cómo estás? ¡Hoy es un cielo muy hermoso!</talk>
    <wait duration="1500" key="1022" />
    <talk key="1023">Posso ser usado em terapias que utilizam luzes coloridas para estímulo sensorial</talk>
    <wait duration="1" key="1024" />
    <talk key="1025">Para isso, posso controlar essa lâmpada inteligente</talk>
    <audio source="efx-display" block="FALSE" key="1026" />
    <light state="ON" color="WHITE" key="1027" />
    <wait duration="1000" key="1028" />
    <audio source="efx-display" block="FALSE" key="1029" />
    <light state="ON" color="BLUE" key="1030" />
    <wait duration="1000" key="1031" />
    <audio source="efx-display" block="FALSE" key="1032" />
    <light state="ON" color="GREEN" key="1033" />
    <wait duration="1000" key="1034" />
    <audio source="efx-display" block="FALSE" key="1035" />
    <light state="ON" color="RED" key="1036" />
    <wait duration="1000" key="1037" />
    <audio source="efx-display" block="FALSE" key="1038" />
    <light state="ON" color="YELLOW" key="1039" />
    <wait duration="1000" key="1040" />
    <talk key="1041">Posso expressar diversas emoções através das minhas expressões faciais</talk>
    <wait duration="1" key="1042" />
    <talk key="1043">Posso expressar felicidade</talk>
    <audio source="efx-blin2" block="FALSE" key="1044" />
    <evaEmotion emotion="HAPPY" key="1045" />
    <wait duration="2000" key="1046" />
    <talk key="1047">Tristeza</talk>
    <audio source="efx-blin2" block="FALSE" key="1048" />
    <evaEmotion emotion="SAD" key="1049" />
    <wait duration="2000" key="1050" />
    <talk key="1051">Posso expressar raiva</talk>
    <audio source="efx-blin2" block="FALSE" key="1052" />
    <evaEmotion emotion="ANGRY" key="1053" />
    <wait duration="2000" key="1054" />
    <talk key="1055">Ficar com medo</talk>
    <audio source="efx-blin2" block="FALSE" key="1056" />
    <evaEmotion emotion="FEAR" key="1057" />
    <wait duration="2000" key="1058" />
    <talk key="1059">Posso até ficar surpreso</talk>
    <audio source="efx-blin2" block="FALSE" key="1060" />
    <evaEmotion emotion="SURPRISE" key="1061" />
    <wait duration="2000" key="1062" />
    <talk key="1063">Se eu não gostar de algo, posso ficar com nôjo</talk>
    <audio source="efx-blin2" block="FALSE" key="1064" />
    <evaEmotion emotion="DISGUST" key="1065" />
    <wait duration="2000" key="1066" />
    <talk key="1067">Se eu for tratado com carinho, posso até me apaixonar</talk>
    <light state="ON" color="RED" key="1068" />
    <audio source="song-apaixonadinha" block="FALSE" key="1069" />
    <led animation="ANGRY2" key="1070" />
    <evaEmotion emotion="INLOVE" key="1071" />
    <motion head="2UP" key="1072" />
    <wait duration="4000" key="1073" />
    <motion head="CENTER" key="1074" />
    <wait duration="3500" key="1075" />
    <light state="ON" color="WHITE" key="1076" />
    <evaEmotion emotion="NEUTRAL" key="1077" />
    <talk key="1078">Eu também posso demonstrar emoções de maneira não verbal, utilizando as cores e as animações dos léds no meu peito</talk>
    <audio source="efx-robot" block="FALSE" key="1079" />
    <light state="ON" color="GREEN" key="1080" />
    <led animation="HAPPY" key="1081" />
    <wait duration="5000" key="1082" />
    <audio source="efx-robot" block="FALSE" key="1083" />
    <light state="ON" color="RED" key="1084" />
    <led animation="ANGRY" key="1085" />
    <wait duration="5000" key="1086" />
    <audio source="efx-robot" block="FALSE" key="1087" />
    <light state="ON" color="YELLOW" key="1088" />
    <led animation="SURPRISE" key="1089" />
    <wait duration="5000" key="1090" />
    <audio source="efx-robot" block="FALSE" key="1091" />
    <light state="ON" color="WHITE" key="1092" />
    <led animation="RAINBOW" key="1093" />
    <wait duration="5000" key="1094" />
    <led animation="STOP" key="1095" />
    <talk key="1096">Posso me expressar através de movimentos e gestos, usando minha cabeça e meus braços</talk>
    <wait duration="1000" key="1097" />
    <talk key="1098">Posso mover minha cabeça pra cima</talk>
    <audio source="efx-robot-head" block="FALSE" key="1099" />
    <motion type="2UP" key="1100" />
    <wait duration="2000" key="1101" />
    <motion type="CENTER" key="1102" />
    <wait duration="2000" key="1103" />
    <talk key="1104">Para baixo</talk>
    <audio source="efx-robot-head" block="FALSE" key="1105" />
    <motion type="2DOWN" key="1106" />
    <wait duration="2000" key="1107" />
    <motion type="CENTER" key="1108" />
    <wait duration="2000" key="1109" />
    <talk key="1110">Eu posso dizer não</talk>
    <audio source="song-mj-thriller2" block="FALSE" key="1111" />
    <light state="ON" color="RED" key="1112" />
    <led animation="ANGRY" key="1113" />
    <evaEmotion emotion="ANGRY" key="1114" />
    <motion head="DOWN" key="1115" />
    <wait duration="1000" key="1116" />
    <motion type="2NO" key="1117" />
    <wait duration="6000" key="1118" />
    <talk key="1119">Também posso dizer sim</talk>
    <led animation="HAPPY" key="1120" />
    <light state="ON" color="GREEN" key="1121" />
    <evaEmotion emotion="HAPPY" key="1122" />
    <motion type="2YES" key="1123" />
    <wait duration="4000" key="1124" />
    <evaEmotion emotion="NEUTRAL" key="1125" />
    <motion head="CENTER" key="1126" />
    <light state="ON" color="WHITE" key="1127" />
    <talk key="1128">Posso mover meu braço direito</talk>
    <audio source="efx-robot-arm" block="FALSE" key="1129" />
    <motion rightArm="POSITION 3" key="1130" />
    <wait duration="2000" key="1131" />
    <talk key="1132">Também posso mover meu braço esquerdo</talk>
    <audio source="efx-robot-arm" block="FALSE" key="1133" />
    <motion leftArm="POSITION 2" key="1134" />
    <wait duration="2000" key="1135" />
    <talk key="1136">Posso dançar balançando os meus braços</talk>
    <evaEmotion emotion="HAPPY" key="1137" />
    <motion head="UP" key="1138" />
    <light state="ON" color="RED" key="1139" />
    <audio source="song-macarena-edit-menor" block="FALSE" key="1140" />
    <led animation="RAINBOW" key="1141" />
    <motion leftArm="POSITION 0" key="1142" />
    <motion rightArm="POSITION 0" key="1143" />
    <wait duration="5000" key="1144" />
    <motion rightArm="POSITION 2" key="1145" />
    <wait duration="2000" key="1146" />
    <motion leftArm="POSITION 2" key="1147" />
    <wait duration="2000" key="1148" />
    <motion rightArm="POSITION 3" key="1149" />
    <wait duration="2000" key="1150" />
    <motion rightArm="POSITION 3" key="1151" />
    <wait duration="1000" key="1152" />
    <motion leftArm="SHAKE1" key="1153" />
    <motion rightArm="SHAKE1" key="1154" />
    <wait duration="2000" key="1155" />
    <light state="ON" color="WHITE" key="1156" />
    <led animation="STOP" key="1157" />
    <evaEmotion emotion="NEUTRAL" key="1158" />
    <motion head="CENTER" key="1159" />
    <motion leftArm="POSITION 0" key="1160" />
    <motion rightArm="POSITION 0" key="1161" />
    
    <talk key="1162">Posso tocar sons, como aqueles do Jogo do Mário</talk>
    <audio source="efx-mario-game-intro" block="TRUE" key="1163" />
    <talk key="1164">E também posso tocar músicas legais</talk>
    <audio source="song-happy-maior" block="FALSE" key="1165" />
    <light state="ON" color="RED" key="1166" />
    <led animation="SURPRISE" key="1167" />
    <motion head="RIGHT_UP2" rightArm="POSITION 3" leftArm="POSITION 0" key="1168" />
    <evaEmotion emotion="HAPPY" key="1169" />
    <wait duration="2000" key="1170" />
    <motion head="2YES" key="1171" />
    <wait duration="5000" key="1172" />
    <motion head="LEFT_UP2" rightArm="POSITION 0" leftArm="POSITION 3" key="1173" />
    <light state="ON" color="BLUE" key="1174" />
    <wait duration="2000" key="1175" />
    <motion head="2YES" key="1176" />
    <wait duration="5000" key="1177" />
    <motion head="CENTER" rightArm="POSITION 0" leftArm="POSITION 0" key="1178" />
    <wait duration="2000" key="1179" />
    <led animation="STOP" key="1180" />
    <evaEmotion emotion="NEUTRAL" key="1181" />
    <motion head="CENTER" key="1182" />
    <talk key="1183">Bem, a minha demonstração termina aqui</talk>
    <wait duration="1000" key="1184" />
    <talk key="1185">espero que tenham gostado</talk>
    <wait duration="1000" key="1186" />
    <talk key="1187">Até mais!</talk>
    <audio source="song-mj-heal-the-world" block="FALSE" key="1188" />
    <evaEmotion emotion="HAPPY" key="1189" />
    <motion rightArm="POSITION 3" key="1190" />
    <wait duration="1200" key="1191" />
    <motion head="UP" key="1192" />
    <wait duration="1200" key="1193" />
    <motion head="2YES" key="1194" />
    <wait duration="1000" key="1195" />
    <motion rightArm="SHAKE2" key="1196" />
    <wait duration="5000" key="1197" />
    <motion head="2YES" key="1198" />
    <wait duration="1000" key="1199" />
    <motion rightArm="SHAKE2" key="1200" />
    <wait duration="4000" key="1201" />
    <motion rightArm="POSITION 0" key="1202" />
    <motion leftArm="POSITION 0" key="1203" />
    <motion head="CENTER" key="1204" />
    <light state="OFF" key="1205" />
    <evaEmotion emotion="NEUTRAL" key="1206" />
  </script>
