<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="galaxya" xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd" id="cf43ef1969935ef73dcb5ea4361b4a09">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" key="1000" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <evaEmotion emotion="HAPPY" key="1001" /> 
    <talk key="1002">Olá! Meu nome é Eva.</talk>   
    <talk key="1003">Qual é o seu nome?</talk>
    <listen var="nome" key="1004" />
    <talk key="1005">#nome , você gostaria de ajuda para estudar Inglês?
          para aprender o verbo to be</talk>
    <listen key="1006" /> 
    <switch var="$">
      <case op="exact" value="sim" key="1007" child_proc="true" var="$">
        <evaEmotion emotion="INLOVE" key="1008" />
        <talk key="1009">”legal vamos la”</talk> 
        <audio source="efx-mario-game-intro" block="TRUE" key="1010" /> 
        <talk key="1011"> preste atenção na musica </talk> 
        <audio source="Bruno Mars.wav" block="TRUE" key="1012" /> 
        <talk key="1013"> indique com o cartao qual verbo to be está na musica </talk> 
        <qrRead id="voltar" key="1014" />  
        <switch var="$">
          <case op="exact" value="are" key="1015" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1016" />
            <talk key="1017">”parabéns!!! você acertou!”</talk> 
            <audio source="efx-aplausos-bom" block="TRUE" key="1018" /> 
          </case>
          <default key="1019" child_proc="true" value="" op="exact"> 
            <talk key="1020"> 
              você errou tente novamente
            </talk>
            <goto target="voltar" />
          </default>
        </switch>
    </case>
    <case op="exact" value="não" key="1021" child_proc="true" var="$">
        <evaEmotion emotion="SAD" key="1022" />
        <talk key="1023">”ai que pena, até a próxima.”</talk> 
        <audio source="song-sad-violin" block="TRUE" key="1024" />
    </case>
    <default key="1025" child_proc="false" value="" op="exact" /></switch>
  </script>
<links><link from="1000" to="1001" /><link from="1001" to="1002" /><link from="1002" to="1003" /><link from="1003" to="1004" /><link from="1004" to="1005" /><link from="1005" to="1006" /><link from="1006" to="1007" /><link from="1007" to="1008" /><link from="1008" to="1009" /><link from="1009" to="1010" /><link from="1010" to="1011" /><link from="1011" to="1012" /><link from="1012" to="1013" /><link from="1013" to="1014" /><link from="1014" to="1015" /><link from="1015" to="1016" /><link from="1016" to="1017" /><link from="1017" to="1018" /><link from="1014" to="1019" /><link from="1019" to="1020" /><link from="1020" to="1014" /><link from="1006" to="1021" /><link from="1021" to="1022" /><link from="1022" to="1023" /><link from="1023" to="1024" /><link from="1006" to="1025" /></links></evaml>